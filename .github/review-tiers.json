{
  "about": "Review tiers by path (REVIEW.md), read by AUGUR's Review workflow. High if any path matches high (and not notHigh), Low if every path matches low (and not notLow), otherwise Medium. harryOk: the High paths that also wait for Harry's ok. Globs follow node:path matchesGlob.",
  "high": [
    "packages/kit-common/tokens/**",
    "packages/*/src/index.ts",
    "packages/*/package.json",
    "packages/app-kit/remote-allowlist.json",
    "packages/kit-bundle/**",
    "package.json",
    ".github/**",
    "scripts/publish-packages*",
    "scripts/pending-bumps.mjs",
    "REVIEW.md"
  ],
  "notHigh": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.testing.ts",
    "**/README.md"
  ],
  "low": [
    "**/*.md",
    ".changeset/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.mjs",
    "**/*.stories.tsx"
  ],
  "notLow": [
    "REVIEW.md",
    "AGENTS.md",
    "CLAUDE.md",
    "**/tokens-only.test.ts"
  ],
  "harryOk": [
    ".github/workflows/**",
    ".github/review-tiers.json",
    "REVIEW.md",
    "packages/kit-bundle/**",
    "scripts/publish-packages*"
  ],
  "deployTest": []
}
