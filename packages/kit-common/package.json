{
  "name": "@augur/kit-common",
  "version": "0.9.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Common: AUGUR's tokens, its typefaces, the Tailwind theme built from them, and the parts both kits (Aerie for the shell, Quill for apps) share.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/generated/tokens.d.ts",
      "default": "./dist/generated/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./theme.css": "./dist/theme.css",
    "./theme-shell.css": "./dist/theme-shell.css",
    "./theme-app.css": "./dist/theme-app.css",
    "./kit.css": "./dist/kit.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && node scripts/build-fonts.mjs && tsc -p tsconfig.json && tailwindcss -i src/kit.css -o dist/kit.css --minify",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-tokens.mjs && node scripts/build-fonts.mjs && vitest run",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "style-dictionary": "5.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/instrument-sans": "5.2.8",
    "@fontsource/nunito": "5.2.7",
    "lucide-react": "1.62.0",
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
