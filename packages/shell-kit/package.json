{
  "name": "@augur/shell-kit",
  "version": "0.10.3",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Aerie: the shell's own React kit, on Common, with Quill's Palette and RadialMenu for the frame it draws round apps (Quill is a peer: the shell serves it). Only the shell uses it: it is published for the shell to build with, but it is not in the kit bundle, not in the import map and not part of the SDK promise.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./kit.css": "./dist/kit.css"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/kit.css -o dist/kit.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@augur/kit-common": "workspace:*"
  },
  "peerDependencies": {
    "@augur/app-kit": "workspace:>=0.14.1 <1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@augur/app-kit": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
