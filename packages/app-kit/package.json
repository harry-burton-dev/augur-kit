{
  "name": "@augur/app-kit",
  "version": "0.22.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Quill: the React kit apps build with, on Common. Served to every app through the shell's import map, under the SDK promise.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote/elements.d.ts",
      "default": "./dist/remote/elements.js"
    },
    "./remote/allowlist.json": "./remote-allowlist.json",
    "./theme.css": "./theme.css",
    "./kit.css": "./dist/kit.css",
    "./door.schema.json": "./door.schema.json"
  },
  "files": [
    "dist",
    "theme.css",
    "remote-allowlist.json",
    "door.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tailwindcss -i src/kit.css -o dist/kit.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@augur/kit-common": "workspace:*",
    "@internationalized/date": "3.12.4",
    "@remote-dom/core": "1.12.1",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-blockquote": "3.32.2",
    "@tiptap/extension-bold": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-italic": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-mention": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "markdown-it": "^14.3.3",
    "openapi-fetch": "0.17.0",
    "prosemirror-markdown": "1.13.9",
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
