{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency updates for the kit: weekly, grouped, never merged by Renovate, as in AUGUR (its ADR 0033).",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "before 7am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "automerge": false,
  "prConcurrentLimit": 6,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "rangeStrategy": "auto",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on the first day of the month"
    ]
  },
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "One PR a week for every minor and patch update to npm packages past 1.0.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "groupName": "npm minor and patch updates"
    },
    {
      "description": "GitHub Actions used by the workflows, together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Majors wait on the dashboard until someone asks for them: each one may need code or an upgrade note.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "React moves with an SDK major (AUGUR's ADR 0015): never in the weekly group.",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
